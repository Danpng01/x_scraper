# Copy to .env in this same folder. Fill in your own values.
# Claude settings matching the attached architecture package.
ANTHROPIC_BASE_URL=https://lum.id/claude
ANTHROPIC_AUTH_TOKEN=PASTE_YOUR_AUTH_TOKEN_HERE
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional alternative: run with --analysis gemini.
# GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
# GEMINI_MODEL=gemini-3.1-flash-lite

# X collection via Twikit. Unneeded when using an existing own-session cookie file.
X_USERNAME=your_username
X_EMAIL=your_email
X_PASSWORD="your_password"

# Optional: only for --source api (official paid X API).
# X_BEARER_TOKEN=PASTE_YOUR_X_API_BEARER_TOKEN_HERE
